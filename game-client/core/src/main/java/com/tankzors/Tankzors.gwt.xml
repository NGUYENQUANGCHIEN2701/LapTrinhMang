  cùng với html module). Core KHÔNG entry point (html module kế thừa).
-->
<!DOCTYPE module PUBLIC "-//Google Inc.//DTD Google Web Toolkit //EN"
        "http://www.gwtproject.org/doctype/2.10.0/gwt-module.dtd">
<module rename-to="tankzorscore">
