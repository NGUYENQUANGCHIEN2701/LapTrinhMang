<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC "-//Google Inc.//DTD Google Web Toolkit //EN"
        "http://www.gwtproject.org/doctype/2.10.0/gwt-module.dtd">
<!--
  GWT module chính của HTML5 client. Kế thừa core logic (Tankzors.gwt.xml)
  + LibGDX GWT backend, khai báo HtmlLauncher làm entry point.

  Compiled output: tankzorshtml/tankzorshtml.nocache.js (rename-to).
-->
<module rename-to="tankzorshtml">
    <inherits name="com.google.gwt.user.User"/>
    <inherits name="com.badlogic.gdx.backends.gdx_backends_gwt"/>
    <inherits name="com.tankzors.Tankzors"/>
    <!-- LibGDX gwtref cần source của jsinterop annotations -->
    <inherits name="jsinterop.Annotations"/>

    <entry-point class="com.tankzors.client.html.HtmlLauncher"/>

    <!-- Asset path thu muc assets dung chung (relatively to html module dir). -->
    <!-- Output được serve tại /game/libgdx nên assets nằm cùng cấp index.html. -->
    <set-configuration-property name="gdx.assetpath" value="assets"/>

    <set-property name="user.agent" value="safari, gecko1_8"/>
    <extend-property name="locale" values="en"/>
    <set-property-fallback name="locale" value="en"/>

    <!-- Compilt: collapsed perms để giảm permutation -->
    <collapse-all-properties/>
</module>
